{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-paper",
  "account_id": "c023da92383ce204b357f6f18b86eb86",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 인라인 스크립트(next-themes)에 __name이 들어가 브라우저에서 에러가 난다
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // 검색엔진 소유확인 파일은 .html 주소 그대로 200으로 제공한다.
    "html_handling": "none"
  },
  "routes": [
    { "pattern": "paper-digest.app", "custom_domain": true },
    { "pattern": "www.paper-digest.app", "custom_domain": true }
  ],
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "ai-paper" }
  ],
  // 페이지 캐시(open-next.config.ts). 버킷에 14일 수명 규칙이 걸려 있다
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ai-paper-inc-cache" }
  ],
  "observability": { "enabled": true }
}
